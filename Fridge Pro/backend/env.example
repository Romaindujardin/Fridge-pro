# Database
DATABASE_URL="postgresql://username:password@localhost:5432/fridge_pro?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"

# Google Gemini AI
# GEMINI_API_KEY=""

# Mot de passe des comptes de démo créés par `prisma db seed`
# (définir une valeur forte en production, ex. quand on seed Neon)
# SEED_PASSWORD=""

# Server
PORT=5000
NODE_ENV="development"

# CORS
FRONTEND_URL="http://localhost:3000"

# File Upload
MAX_FILE_SIZE="10485760" # 10MB
UPLOAD_DIR="uploads" 