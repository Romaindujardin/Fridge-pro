# Example terraform.tfvars file
# Copy this to terraform.tfvars and customize

# Project Configuration
project_name = "fridgepro"
environment  = "dev"
location     = "eastus"

# Database Configuration
db_admin_username = "fridgeadmin"
db_admin_password = "ChangeThisPassword123!@#"
db_name           = "fridge_pro"
db_sku_name       = "B_Standard_B1ms"

# App Service Configuration
app_service_sku = "B1"

# Application Configuration
jwt_secret = "your-super-secret-jwt-key-change-this-in-production"

# Optional: Custom domain for frontend
# frontend_custom_domain = "app.yourdomain.com"

# Tags
common_tags = {
  Project     = "Fridge Pro"
  ManagedBy   = "Terraform"
  Environment = "dev"
  Team        = "Your Team Name"
}
